<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="shell-type" content="web_dashboard" />
  <title><%= typeof title !== 'undefined' ? title : 'SIMNILAI v3.0 • SMAN 1 Nusantara' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-primary": "#ffffff",
            "on-secondary-fixed-variant": "#00504a",
            "on-primary-fixed": "#002114",
            "primary-fixed": "#abf2cd",
            "on-surface": "#0b1c30",
            "on-secondary": "#ffffff",
            "on-tertiary": "#ffffff",
            "surface": "#f8fafc",
            "surface-card": "#ffffff",
            "surface-border": "#e2e8f0",
            "secondary-container": "#d1fae5",
            "surface-variant": "#e2e8f0",
            "surface-dim": "#cbd5e1",
            "primary": "#005338",
            "secondary": "#047857",
            "inverse-on-surface": "#eaf1ff",
            "on-tertiary-fixed-variant": "#065f46",
            "primary-container": "#005338",
            "on-primary-container": "#a7f3d0",
            "on-secondary-container": "#064e3b",
            "on-error-container": "#93000a",
            "on-error": "#ffffff",
            "surface-container-lowest": "#ffffff",
            "outline-variant": "#cbd5e1",
            "primary-fixed-dim": "#8fd5b2",
            "secondary-fixed-dim": "#a7f3d0",
            "surface-container-low": "#f1f5f9",
            "surface-tint": "#005338",
            "on-surface-variant": "#334155",
            "tertiary-fixed": "#d1fae5",
            "surface-container-high": "#e2e8f0",
            "secondary-fixed": "#d1fae5",
            "tertiary-fixed-dim": "#a7f3d0",
            "on-tertiary-container": "#064e3b",
            "on-secondary-fixed": "#002114",
            "surface-bright": "#f8f9ff",
            "on-tertiary-fixed": "#002114",
            "background": "#f8fafc",
            "on-background": "#0b1c30",
            "tertiary-container": "#005338",
            "surface-container-highest": "#cbd5e1",
            "error-container": "#ffdad6",
            "error": "#ba1a1a",
            "surface-container": "#f1f5f9",
            "inverse-surface": "#213145",
            "outline": "#64748b",
            "inverse-primary": "#8fd5b2",
            "tertiary": "#005338",
            "on-primary-fixed-variant": "#003a26",
            "text-primary": "#0f172a",
            "text-secondary": "#334155",
            "text-muted": "#64748b",
            "status-success-bg": "#ecfdf5",
            "status-success-text": "#065f46",
            "status-info-bg": "#f0fdfa",
            "status-info-text": "#115e59",
            "status-warning-bg": "#fffbeb",
            "status-warning-text": "#92400e",
            "status-danger-bg": "#fef2f2",
            "status-danger-text": "#991b1b"
          },
          borderRadius: {
            DEFAULT: "0.25rem",
            lg: "0.5rem",
            xl: "0.75rem",
            full: "9999px"
          },
          spacing: {
            "gutter-desktop": "1.5rem",
            "space-lg": "1.25rem",
            "space-xs": "0.25rem",
            "space-md": "0.75rem",
            "margin": "1rem",
            "space-xl": "2rem",
            "margin-desktop": "2rem",
            "gutter": "1rem",
            "space-sm": "0.5rem"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "Inter", "sans-serif"],
            "body-sm": ["Plus Jakarta Sans", "Inter"],
            "body-lg": ["Plus Jakarta Sans", "Inter"],
            "numeric-table": ["Plus Jakarta Sans", "Inter"],
            "label-md": ["Plus Jakarta Sans", "Inter"],
            "headline-xl-mobile": ["Plus Jakarta Sans"],
            "body-md": ["Plus Jakarta Sans", "Inter"],
            "numeric-score": ["Plus Jakarta Sans"],
            "headline-lg": ["Plus Jakarta Sans"],
            "label-sm": ["Plus Jakarta Sans", "Inter"],
            "headline-md": ["Plus Jakarta Sans"],
            "headline-xl": ["Plus Jakarta Sans"],
            "headline-lg-mobile": ["Plus Jakarta Sans"]
          },
          fontSize: {
            "body-sm": ["12px", { lineHeight: "18px", fontWeight: "400" }],
            "body-lg": ["16px", { lineHeight: "24px", fontWeight: "400" }],
            "numeric-table": ["13px", { lineHeight: "18px", fontWeight: "500" }],
            "label-md": ["13px", { lineHeight: "18px", fontWeight: "500" }],
            "headline-xl-mobile": ["24px", { lineHeight: "32px", fontWeight: "700" }],
            "body-md": ["14px", { lineHeight: "20px", fontWeight: "400" }],
            "numeric-score": ["15px", { lineHeight: "20px", fontWeight: "700" }],
            "headline-lg": ["24px", { lineHeight: "32px", fontWeight: "600" }],
            "label-sm": ["11px", { lineHeight: "14px", fontWeight: "600" }],
            "headline-md": ["18px", { lineHeight: "26px", fontWeight: "600" }],
            "headline-xl": ["30px", { lineHeight: "38px", fontWeight: "700" }],
            "headline-lg-mobile": ["20px", { lineHeight: "28px", fontWeight: "600" }]
          }
        }
      }
    };
  </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      display: inline-block;
      vertical-align: middle;
      line-height: 1;
    }
  </style>
</head>
<body class="bg-surface font-body-md text-on-surface antialiased min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="pl-64">
    <%- include('../partials/header') %>
    <main class="w-full pt-16 bg-surface min-h-screen">
      <% if (typeof flash !== 'undefined' && flash.error) { %>
        <div class="max-w-7xl mx-auto px-gutter-desktop pt-4">
          <div class="p-3.5 rounded-xl bg-status-danger-bg border border-red-200 text-status-danger-text text-sm font-medium flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">error</span>
            <span><%= flash.error %></span>
          </div>
        </div>
      <% } %>
      <% if (typeof flash !== 'undefined' && flash.success) { %>
        <div class="max-w-7xl mx-auto px-gutter-desktop pt-4">
          <div class="p-3.5 rounded-xl bg-status-success-bg border border-emerald-200 text-status-success-text text-sm font-medium flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
            <span><%= flash.success %></span>
          </div>
        </div>
      <% } %>
      <%- body %>
    </main>
  </div>
</body>
</html>
