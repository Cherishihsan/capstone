<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title><%= typeof title !== 'undefined' ? title : 'Masuk SIMNILAI v3.0 • SMA Negeri 1 Nusantara' %></title>
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "error": "#ba1a1a",
            "error-container": "#ffdad6",
            "secondary": "#006a63",
            "status-success-bg": "#ecfdf5",
            "surface-container-lowest": "#ffffff",
            "on-surface": "#0b1c30",
            "surface-container-high": "#dce9ff",
            "on-primary-container": "#80c5a3",
            "on-error-container": "#93000a",
            "on-tertiary-fixed-variant": "#3323cc",
            "surface-container": "#f1f5f9",
            "on-secondary": "#ffffff",
            "on-tertiary": "#ffffff",
            "on-background": "#0b1c30",
            "on-secondary-fixed-variant": "#00504a",
            "status-danger-text": "#991b1b",
            "secondary-fixed-dim": "#80d5cb",
            "surface-tint": "#246a4d",
            "on-surface-variant": "#404943",
            "tertiary-fixed-dim": "#c3c0ff",
            "outline": "#707973",
            "status-warning-border": "#fde68a",
            "status-danger-border": "#fecaca",
            "on-tertiary-fixed": "#0f0069",
            "inverse-surface": "#213145",
            "surface-container-low": "#eff4ff",
            "status-info-bg": "#f0fdfa",
            "text-secondary": "#334155",
            "on-primary-fixed-variant": "#005237",
            "on-primary": "#ffffff",
            "tertiary-container": "#3525cd",
            "surface-variant": "#d3e4fe",
            "on-tertiary-container": "#b1afff",
            "inverse-primary": "#8fd5b2",
            "surface-card": "#ffffff",
            "text-muted": "#64748b",
            "on-primary-fixed": "#002114",
            "surface-border": "#e2e8f0",
            "status-info-border": "#99f6e4",
            "status-warning-bg": "#fffbeb",
            "status-success-text": "#065f46",
            "text-primary": "#0f172a",
            "on-error": "#ffffff",
            "secondary-container": "#99efe5",
            "inverse-on-surface": "#eaf1ff",
            "status-danger-bg": "#fef2f2",
            "background": "#f8f9ff",
            "secondary-fixed": "#9cf2e8",
            "tertiary": "#1e00a9",
            "primary-fixed-dim": "#8fd5b2",
            "surface-bright": "#f8f9ff",
            "primary": "#003a26",
            "status-warning-text": "#92400e",
            "surface": "#f8fafc",
            "tertiary-fixed": "#e2dfff",
            "on-secondary-fixed": "#00201d",
            "surface-container-highest": "#d3e4fe",
            "primary-container": "#005338",
            "outline-variant": "#bfc9c1",
            "on-secondary-container": "#006f67",
            "primary-fixed": "#abf2cd",
            "surface-dim": "#cbdbf5",
            "status-info-text": "#115e59",
            "status-success-border": "#a7f3d0"
          },
          borderRadius: {
            DEFAULT: "0.25rem",
            lg: "0.5rem",
            xl: "0.75rem",
            full: "9999px"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      display: inline-block;
      vertical-align: middle;
      line-height: 1;
    }
  </style>
</head>
<body class="bg-surface text-on-surface min-h-screen flex flex-col font-sans antialiased selection:bg-primary-container selection:text-white">
  <!-- Top Institutional Bar -->
  <header class="w-full bg-surface-card border-b border-surface-border py-3 px-6 lg:px-12 flex items-center justify-between z-20">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-primary-container text-white flex items-center justify-center shadow-sm">
        <span class="material-symbols-outlined text-[20px]">school</span>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-text-primary text-base tracking-tight leading-none">SIMNILAI</span>
        </div>
        <span class="text-xs text-text-muted font-medium block">SMA NEGERI 1 NUSANTARA</span>
      </div>
    </div>
    <!-- Status Badges & Quick Links -->
    <div class="hidden md:flex items-center gap-3">
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container border border-surface-border text-text-secondary text-xs font-semibold">
        <span class="material-symbols-outlined text-[16px] text-primary-container">calendar_month</span>
        <span>T.A. 2026/2027 • Ganjil</span>
      </div>
      <a class="text-xs font-semibold text-primary-container hover:underline ml-2 flex items-center gap-1" href="#bantuan">
        <span class="material-symbols-outlined text-[15px]">help</span>
        Bantuan IT TU
      </a>
    </div>
  </header>

  <!-- Main Login Workspace -->
  <main class="flex-1 flex items-center justify-center p-4 lg:p-10">
    <div class="w-full max-w-[500px] bg-surface-card border border-surface-border rounded-xl shadow-sm overflow-hidden p-8 lg:p-10 flex flex-col justify-center my-auto">
      <div class="w-full space-y-6">
        <!-- Form Header -->
        <div class="text-center">
          <h2 class="text-2xl font-bold text-text-primary tracking-tight">Masuk ke Akun Anda</h2>
          <p class="text-sm text-text-secondary mt-1">
            Silakan masukkan NIP/NUPTK/NIS atau Email dan kata sandi yang terdaftar di Tata Usaha sekolah.
          </p>
        </div>

        <% if (typeof flash !== 'undefined' && flash.error) { %>
          <div class="p-3 rounded-lg bg-status-danger-bg border border-status-danger-border text-status-danger-text text-xs font-semibold flex items-center gap-2" role="alert">
            <span class="material-symbols-outlined text-[18px]">error</span>
            <span><%= flash.error %></span>
          </div>
        <% } %>
        <% if (typeof flash !== 'undefined' && flash.success) { %>
          <div class="p-3 rounded-lg bg-status-success-bg border border-status-success-border text-status-success-text text-xs font-semibold flex items-center gap-2" role="alert">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
            <span><%= flash.success %></span>
          </div>
        <% } %>

        <form action="/login" class="space-y-4" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <!-- Identifier Input -->
          <div>
            <label class="block text-xs font-bold text-text-primary uppercase tracking-wider mb-1.5" for="email">
              NIP / NUPTK / Email Akun
            </label>
            <div class="relative rounded-lg">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-text-muted">
                <span class="material-symbols-outlined text-[18px]">badge</span>
              </div>
              <input
                class="block w-full pl-10 pr-3 py-2.5 text-sm bg-surface rounded-lg border border-surface-border text-text-primary placeholder:text-text-muted placeholder:text-xs focus:bg-white focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all"
                id="email"
                name="email"
                placeholder="admin@sekolah.sch.id atau budi.guru@sekolah.sch.id"
                required
                type="text"
              />
            </div>
            <p class="text-[11px] text-text-muted mt-1">Gunakan identitas NUPTK, NIP, NIS, atau email resmi yang terdaftar.</p>
          </div>

          <!-- Password Input -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-bold text-text-primary uppercase tracking-wider" for="password">
                Kata Sandi
              </label>
              <a class="text-xs font-semibold text-primary-container hover:underline" href="#lupa-sandi">
                Lupa Kata Sandi?
              </a>
            </div>
            <div class="relative rounded-lg">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-text-muted">
                <span class="material-symbols-outlined text-[18px]">lock</span>
              </div>
              <input
                class="block w-full pl-10 pr-10 py-2.5 text-sm bg-surface rounded-lg border border-surface-border text-text-primary placeholder:text-text-muted focus:bg-white focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all"
                id="password"
                name="password"
                placeholder="••••••••••••"
                required
                type="password"
              />
              <button
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-text-muted hover:text-text-primary"
                id="toggle-pwd-btn"
                onclick="togglePassword()"
                title="Lihat kata sandi"
                type="button"
              >
                <span class="material-symbols-outlined text-[18px]" id="pwd-icon">visibility</span>
              </button>
            </div>
          </div>

          <!-- Remember Device -->
          <div class="flex items-center pt-1">
            <input
              class="h-4 w-4 rounded border-surface-border text-primary-container focus:ring-primary-container"
              id="remember_me"
              name="remember_me"
              type="checkbox"
            />
            <label class="ml-2 block text-xs font-medium text-text-secondary cursor-pointer select-none" for="remember_me">
              Ingat saya di perangkat ini (30 hari sesi aman)
            </label>
          </div>

          <!-- Primary Action Button (Solid Emerald) -->
          <button
            class="w-full mt-2 py-3 px-4 rounded-lg bg-primary-container hover:bg-primary text-white text-sm font-bold tracking-wide transition-colors shadow-sm flex items-center justify-center gap-2"
            type="submit"
          >
            <span>Masuk ke Sistem</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </button>
        </form>

        <!-- Security & Support Footer -->
        <div class="pt-4 border-t border-surface-border text-center space-y-1">
          <p class="text-xs text-text-secondary">
            Mengalami kendala akun? Hubungi <span class="font-bold text-text-primary">Admin Tata Usaha (Ext. 104)</span>
          </p>
          <a class="inline-flex items-center gap-1 text-xs font-semibold text-primary-container hover:underline" href="#panduan">
            <span class="material-symbols-outlined text-[14px]">download</span>
            <span>Unduh Panduan Pengguna Guru &amp; Wali Kelas (PDF)</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <!-- Institutional Copyright Footer -->
  <footer class="w-full py-4 text-center text-xs text-text-muted border-t border-surface-border bg-surface-card">
    <div class="max-w-[1140px] mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-2">
      <div>
        © 2026 SMA Negeri 1 Nusantara • Sistem Informasi Manajemen Nilai, Absensi, dan Dokumen Raport Sekolah.
      </div>
      <div class="flex items-center gap-4 font-medium text-text-secondary">
        <a class="hover:text-primary-container" href="#privasi">Kebijakan Privasi</a>
        <span class="text-surface-border">•</span>
        <a class="hover:text-primary-container" href="#pos">Prosedur Operasional Penilaian (POS)</a>
        <span class="text-surface-border">•</span>
        <a class="hover:text-primary-container" href="#status">Status Server</a>
      </div>
    </div>
  </footer>

  <script>
    function togglePassword() {
      const pwdInput = document.getElementById('password');
      const pwdIcon = document.getElementById('pwd-icon');
      if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        pwdIcon.innerText = 'visibility_off';
      } else {
        pwdInput.type = 'password';
        pwdIcon.innerText = 'visibility';
      }
    }
  </script>
</body>
</html>
