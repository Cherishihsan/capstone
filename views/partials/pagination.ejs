<% if (totalPages > 1) { %>
<div class="pagination" style="display: flex; gap: 5px; margin-top: 20px; justify-content: center;">
  <% if (currentPage > 1) { %>
    <a href="<%= baseUrl %>?page=<%= currentPage - 1 %>" class="btn btn-secondary" style="padding: 5px 10px;">&laquo; Prev</a>
  <% } %>
  
  <% for (let i = 1; i <= totalPages; i++) { %>
    <% if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
      <a href="<%= baseUrl %>?page=<%= i %>" class="btn <%= currentPage == i ? 'btn-primary' : 'btn-secondary' %>" style="padding: 5px 10px;"><%= i %></a>
    <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
      <span style="padding: 5px 10px;">...</span>
    <% } %>
  <% } %>
  
  <% if (currentPage < totalPages) { %>
    <a href="<%= baseUrl %>?page=<%= currentPage + 1 %>" class="btn btn-secondary" style="padding: 5px 10px;">Next &raquo;</a>
  <% } %>
</div>
<% } %>
