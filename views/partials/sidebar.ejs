<%
  const pathNow = typeof currentPath !== 'undefined' ? currentPath : '/dashboard';
  const queryNow = typeof currentQuery !== 'undefined' ? currentQuery : {};
  const tabNow = queryNow.tab || (pathNow.startsWith('/admin/master') ? 'guru' : '');
  const activeClass = 'bg-[#005338] text-white font-label-md rounded-xl shadow-sm';
  const inactiveClass = 'text-slate-600 hover:bg-emerald-50 hover:text-[#005338] font-body-md';
%>
<aside class="fixed left-0 top-0 h-full w-64 bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-50 flex flex-col justify-between border-r border-slate-200 overflow-y-auto">
  <div class="flex flex-col">
    <!-- Brand Logo -->
    <div class="h-16 px-space-lg flex items-center gap-space-sm bg-surface-container-lowest border-b border-slate-100 shrink-0">
      <div class="w-9 h-9 rounded-xl bg-[#005338] flex items-center justify-center text-white shadow-sm">
        <span class="material-symbols-outlined text-[20px]">school</span>
      </div>
      <div class="flex flex-col leading-tight">
        <span class="font-headline-md text-headline-md tracking-tight text-on-surface">SIMNILAI</span>
        <span class="font-label-sm text-label-sm uppercase tracking-wider text-[#005338]">SMAN 1 Nusantara</span>
      </div>
    </div>

    <div class="px-space-md pt-space-sm pb-1">
      <span class="font-label-sm text-label-sm uppercase tracking-wider text-slate-400 px-space-sm">Menu Akademik</span>
    </div>

    <nav class="flex flex-col gap-1 px-space-md">
      <a href="/dashboard" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= pathNow === '/dashboard' ? activeClass : inactiveClass %>">
        <span class="material-symbols-outlined text-[20px]">space_dashboard</span>
        <span>Dashboard</span>
      </a>

      <% if (!user || user.role === 'guru' || user.role === 'admin') { %>
        <a href="/nilai" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= pathNow.startsWith('/nilai') ? activeClass : inactiveClass %>">
          <span class="material-symbols-outlined text-[20px]">edit_note</span>
          <span>Input Nilai</span>
        </a>
        <a href="/absensi" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= pathNow.startsWith('/absensi') ? activeClass : inactiveClass %>">
          <span class="material-symbols-outlined text-[20px]">how_to_reg</span>
          <span>Absensi Harian</span>
        </a>
        <a href="/rapor" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= pathNow === '/rapor' ? activeClass : inactiveClass %>">
          <span class="material-symbols-outlined text-[20px]">picture_as_pdf</span>
          <span>Arsip Raport PDF</span>
        </a>
        <a href="/rapor/monitoring" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= pathNow.startsWith('/rapor/monitoring') ? activeClass : inactiveClass %>">
          <span class="material-symbols-outlined text-[20px]">analytics</span>
          <span>Monitoring Raport</span>
        </a>
      <% } %>

      <% if (user && user.role === 'siswa') { %>
        <a href="/portal/siswa/<%= user.id_siswa %>" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= pathNow.startsWith('/portal/siswa') ? activeClass : inactiveClass %>">
          <span class="material-symbols-outlined text-[20px]">person_book</span>
          <span>Portal Akademik Siswa</span>
        </a>
        <a href="/rapor" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= pathNow === '/rapor' ? activeClass : inactiveClass %>">
          <span class="material-symbols-outlined text-[20px]">picture_as_pdf</span>
          <span>Unduh Raport PDF</span>
        </a>
      <% } %>

      <% if (user && user.role === 'orang_tua') { %>
        <a href="/portal/anak" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= pathNow.startsWith('/portal') ? activeClass : inactiveClass %>">
          <span class="material-symbols-outlined text-[20px]">family_restroom</span>
          <span>Portal Orang Tua</span>
        </a>
        <a href="/rapor" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= pathNow === '/rapor' ? activeClass : inactiveClass %>">
          <span class="material-symbols-outlined text-[20px]">picture_as_pdf</span>
          <span>Unduh Raport Anak</span>
        </a>
      <% } %>

      <% if (!user || user.role === 'admin') { %>
        <div class="pt-3 pb-1">
          <button
            type="button"
            onclick="toggleMasterMenu()"
            class="w-full flex items-center justify-between px-space-sm py-1 text-left font-label-sm text-label-sm uppercase tracking-wider text-slate-500 hover:text-[#005338]"
          >
            <span>Data Master Sekolah</span>
            <span id="master-menu-chevron" class="material-symbols-outlined text-[16px]">expand_more</span>
          </button>
        </div>

        <!-- Tombol Terpisah per Modul Data Master -->
        <div id="master-menu-items" class="flex flex-col gap-1">
          <a href="/admin/master?tab=guru" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= (pathNow.startsWith('/admin/master') && tabNow === 'guru') ? activeClass : inactiveClass %>">
            <span class="material-symbols-outlined text-[19px]">badge</span>
            <span>Data Guru</span>
          </a>
          <a href="/admin/master?tab=siswa" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= (pathNow.startsWith('/admin/master') && tabNow === 'siswa') ? activeClass : inactiveClass %>">
            <span class="material-symbols-outlined text-[19px]">groups</span>
            <span>Data Siswa</span>
          </a>
          <a href="/admin/master?tab=kelas" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= (pathNow.startsWith('/admin/master') && tabNow === 'kelas') ? activeClass : inactiveClass %>">
            <span class="material-symbols-outlined text-[19px]">meeting_room</span>
            <span>Data Kelas &amp; Wali</span>
          </a>
          <a href="/admin/master?tab=mapel" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= (pathNow.startsWith('/admin/master') && tabNow === 'mapel') ? activeClass : inactiveClass %>">
            <span class="material-symbols-outlined text-[19px]">menu_book</span>
            <span>Data Mapel</span>
          </a>
          <a href="/admin/master?tab=semester" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= (pathNow.startsWith('/admin/master') && tabNow === 'semester') ? activeClass : inactiveClass %>">
            <span class="material-symbols-outlined text-[19px]">calendar_month</span>
            <span>Data Semester</span>
          </a>
          <a href="/admin/master?tab=ortu" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= (pathNow.startsWith('/admin/master') && tabNow === 'ortu') ? activeClass : inactiveClass %>">
            <span class="material-symbols-outlined text-[19px]">family_restroom</span>
            <span>Data Orang Tua</span>
          </a>
          <a href="/admin/master?tab=penugasan" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= (pathNow.startsWith('/admin/master') && tabNow === 'penugasan') ? activeClass : inactiveClass %>">
            <span class="material-symbols-outlined text-[19px]">assignment_ind</span>
            <span>Penugasan Guru Mapel</span>
          </a>
          <a href="/admin/master?tab=users" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= (pathNow.startsWith('/admin/master') && tabNow === 'users') ? activeClass : inactiveClass %>">
            <span class="material-symbols-outlined text-[19px]">manage_accounts</span>
            <span>Data Akun &amp; Users</span>
          </a>
        </div>
      <% } %>

      <div class="pt-3 pb-1">
        <span class="font-label-sm text-label-sm uppercase tracking-wider text-slate-400 px-space-sm">Laporan &amp; Sesi</span>
      </div>

      <% if (!user || user.role === 'admin' || user.role === 'guru') { %>
        <a href="/laporan/absensi.xlsx" class="flex items-center gap-space-md px-space-md py-2 rounded-xl transition-colors text-body-md <%= inactiveClass %>">
          <span class="material-symbols-outlined text-[20px]">summarize</span>
          <span>Laporan &amp; Rekap (.xlsx)</span>
        </a>
      <% } %>

      <a href="/logout" class="flex items-center gap-space-md px-space-md py-2 rounded-xl text-red-700 hover:bg-red-50 transition-colors font-body-md text-body-md">
        <span class="material-symbols-outlined text-[20px]">logout</span>
        <span>Keluar Sesi</span>
      </a>
    </nav>
  </div>

  <div class="p-space-md m-space-md rounded-xl bg-slate-100 flex items-center justify-between shrink-0">
    <div class="flex flex-col">
      <span class="font-label-sm text-label-sm text-slate-500">Versi Aplikasi</span>
      <span class="font-numeric-table text-numeric-table text-on-surface">v3.0.4 Enterprise</span>
    </div>
    <span class="material-symbols-outlined text-[#005338] text-[20px]">verified</span>
  </div>
</aside>

<script>
  function toggleMasterMenu() {
    var box = document.getElementById('master-menu-items');
    var icon = document.getElementById('master-menu-chevron');
    if (!box) return;
    box.classList.toggle('hidden');
    if (icon) {
      icon.textContent = box.classList.contains('hidden') ? 'chevron_right' : 'expand_more';
    }
  }
</script>
