<div class="card" style="max-width: 800px; margin: 0 auto;">
  <h2><%= guru ? 'Edit Guru' : 'Tambah Guru' %></h2>
  
  <form action="<%= guru ? `/admin/guru/${guru.id}/update` : '/admin/guru' %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
      <div class="form-group">
        <label class="form-label">NIP</label>
        <input type="text" name="nip" class="form-control" value="<%= guru ? guru.nip : '' %>" required>
      </div>
      <div class="form-group">
        <label class="form-label">Nama</label>
        <input type="text" name="nama" class="form-control" value="<%= guru ? guru.nama : '' %>" required>
      </div>
      <div class="form-group">
        <label class="form-label">No. HP</label>
        <input type="text" name="nomor_hp" class="form-control" value="<%= guru ? guru.nomor_hp : '' %>" required>
      </div>
      <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" value="<%= (guru && guru.user) ? guru.user.email : '' %>" required>
      </div>
      
      <% if (!guru) { %>
      <div class="form-group">
        <label class="form-label">Username (Login)</label>
        <input type="text" name="username" class="form-control" required>
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" required>
      </div>
      <% } %>
    </div>
    
    <div class="form-group" style="margin-top: 15px;">
      <label class="form-label">Kelas Diajar</label>
      <div style="display: flex; flex-wrap: wrap; gap: 10px;">
        <% if (typeof kelasList !== 'undefined') { %>
          <% kelasList.forEach(k => { %>
            <label style="display:flex; align-items:center; gap:5px; background: rgba(255,255,255,0.05); padding: 5px 10px; border-radius: 4px;">
              <input type="checkbox" name="kelas_ids[]" value="<%= k.id %>" <%= (typeof selectedKelas !== 'undefined' && selectedKelas.includes(k.id)) ? 'checked' : '' %>>
              <%= k.nama_kelas %>
            </label>
          <% }) %>
        <% } %>
      </div>
    </div>
    
    <div class="form-group" style="margin-top: 15px;">
      <label class="form-label">Mata Pelajaran Diajar</label>
      <div style="display: flex; flex-wrap: wrap; gap: 10px;">
        <% if (typeof mapelList !== 'undefined') { %>
          <% mapelList.forEach(m => { %>
            <label style="display:flex; align-items:center; gap:5px; background: rgba(255,255,255,0.05); padding: 5px 10px; border-radius: 4px;">
              <input type="checkbox" name="mapel_ids[]" value="<%= m.id %>" <%= (typeof selectedMapel !== 'undefined' && selectedMapel.includes(m.id)) ? 'checked' : '' %>>
              <%= m.nama_mata_pelajaran %>
            </label>
          <% }) %>
        <% } %>
      </div>
    </div>
    
    <div style="margin-top: 30px; display: flex; gap: 10px; justify-content: flex-end;">
      <a href="/admin/guru" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Simpan</button>
    </div>
  </form>
</div>

<% if (typeof flash !== 'undefined' && flash && flash.message) { %>
<script>document.addEventListener('DOMContentLoaded', () => showToast('<%= flash.message %>', '<%= flash.type %>'));</script>
<% } %>
