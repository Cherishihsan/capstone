<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Kelola Data Mata Pelajaran</h2>
    <a href="/admin/mapel/create" class="btn btn-primary">+ Tambah Mata Pelajaran</a>
  </div>

  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>No</th>
          <th>Kode</th>
          <th>Nama Mata Pelajaran</th>
          <th>Status</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (subjects && subjects.length > 0) { %>
          <% subjects.forEach((m, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= m.kode %></td>
            <td><%= m.nama_mata_pelajaran %></td>
            <td>
              <span class="badge <%= m.is_active ? 'badge-hadir' : 'badge-alpa' %>"><%= m.is_active ? 'Aktif' : 'Nonaktif' %></span>
            </td>
            <td>
              <a href="/admin/mapel/<%= m.id %>/edit" class="btn btn-secondary" style="padding: 4px 8px;">Edit</a>
              <form action="/admin/mapel/<%= m.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Yakin ingin menghapus mata pelajaran ini?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger" style="padding: 4px 8px;">Hapus</button>
              </form>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5" style="text-align: center;">Tidak ada data.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  
  <%- include('../../partials/pagination', { baseUrl: '/admin/mapel', currentPage: currentPage || 1, totalPages: totalPages || 1 }) %>
</div>

<% if (typeof flash !== 'undefined' && flash && flash.message) { %>
<script>document.addEventListener('DOMContentLoaded', () => showToast('<%= flash.message %>', '<%= flash.type %>'));</script>
<% } %>
