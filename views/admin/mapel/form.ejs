<div class="card" style="max-width: 600px; margin: 0 auto;">
  <h2><%= mapel ? 'Edit Mata Pelajaran' : 'Tambah Mata Pelajaran' %></h2>
  
  <form action="<%= mapel ? `/admin/mapel/${mapel.id}/update` : '/admin/mapel' %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    
    <div class="form-group">
      <label class="form-label">Kode Mata Pelajaran</label>
      <input type="text" name="kode" class="form-control" value="<%= mapel ? mapel.kode : '' %>" required>
    </div>
    
    <div class="form-group">
      <label class="form-label">Nama Mata Pelajaran</label>
      <input type="text" name="nama_mata_pelajaran" class="form-control" value="<%= mapel ? mapel.nama_mata_pelajaran : '' %>" required>
    </div>
    
    <div style="margin-top: 30px; display: flex; gap: 10px; justify-content: flex-end;">
      <a href="/admin/mapel" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Simpan</button>
    </div>
  </form>
</div>

<% if (typeof flash !== 'undefined' && flash && flash.message) { %>
<script>document.addEventListener('DOMContentLoaded', () => showToast('<%= flash.message %>', '<%= flash.type %>'));</script>
<% } %>
