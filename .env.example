# Server
PORT=3000
SESSION_SECRET=ganti-dengan-rahasia-sesi-produksi-anda
SCHOOL_NAME=SMA Swasta Nusantara

# Basis Data: pilih 'postgres' (PostgreSQL 16+) atau 'mysql' (MySQL 8+)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simnilai
DB_USER=postgres
