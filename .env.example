RAPOR_MAX_SIZE_MB=10

# Notifikasi Email Opsional (FR-16 / NFR-11)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
